from os import PathLike
from typing import Any, Optional

class NeoquadrantError(Exception): ...
class EngineError(NeoquadrantError): ...
class LockedError(NeoquadrantError): ...
class CollectionExistsError(NeoquadrantError): ...
class CollectionNotFoundError(NeoquadrantError): ...
class ClosedError(NeoquadrantError): ...
class InvalidArgumentError(NeoquadrantError): ...

class NativeDatabase:
    @staticmethod
    def open(
        path: Optional[str],
        durability: str,
        flush_interval: float,
        auto_optimize: bool,
        optimize_debounce: float,
        max_indexing_threads: int,
    ) -> NativeDatabase: ...
    @property
    def path(self) -> PathLike[str]: ...
    def create_collection(self, name: str, config: Any) -> NativeCollection: ...
    def get_or_create_collection(self, name: str, config: Any) -> NativeCollection: ...
    def collection(self, name: str) -> NativeCollection: ...
    def has_collection(self, name: str) -> bool: ...
    def list_collections(self) -> list[str]: ...
    def drop_collection(self, name: str) -> bool: ...
    def flush(self) -> None: ...
    def close(self) -> None: ...

class NativeCollection:
    @property
    def name(self) -> str: ...
    def upsert(self, points: Any) -> None: ...
    def query(self, request: Any) -> list[dict[str, Any]]: ...
    def retrieve(self, request: Any) -> list[dict[str, Any]]: ...
    def scroll(self, request: Any) -> dict[str, Any]: ...
    def count(self, request: Any) -> int: ...
    def facet(self, request: Any) -> list[dict[str, Any]]: ...
    def delete(self, selector: Any) -> None: ...
    def set_payload(self, request: Any) -> None: ...
    def overwrite_payload(self, request: Any) -> None: ...
    def delete_payload(self, request: Any) -> None: ...
    def clear_payload(self, selector: Any) -> None: ...
    def create_payload_index(self, request: Any) -> None: ...
    def delete_payload_index(self, field_name: str) -> None: ...
    def optimize(self) -> bool: ...
    def flush(self) -> None: ...
    def info(self) -> dict[str, Any]: ...
