+
+    /// Re-apply operations recorded in the WAL that may not have been persisted in segments yet
+    /// (e.g. after a crash between flushes), the same way the server's `LocalShard` does on load.
+    ///
+    /// Operations already persisted are skipped by segment point versions, so replaying the whole
+    /// unacknowledged WAL is idempotent. An operation that failed when first applied (e.g. a
+    /// wrong vector dimension) fails again here and is skipped.
+    pub(crate) fn replay_wal(&self) -> OperationResult<usize> {
+        let wal = self.wal.lock();
+        let _update_guard = self.segments.acquire_updates_lock();
+        let segments_guard = self.segments.read();
+
+        let mut replayed = 0;
+        for entry in wal.read_all(false) {
+            let (op_num, operation) = entry.map_err(service_error)?;
+            if let Err(err) = self.apply_operation(&segments_guard, op_num, operation) {
+                log::warn!("skipping WAL operation {op_num} during replay: {err}");
+            }
+            replayed += 1;
+        }
+        Ok(replayed)
+    }
