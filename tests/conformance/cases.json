          "op": "create_payload_index",
          "args": {
            "field_name": "color",
            "field_schema": "keyword"
          }
        },
        {
          "op": "create_payload_index",
          "args": {
            "field_name": "rank",
            "field_schema": "integer"
          }
        },
        {
          "op": "upsert",
          "args": [
            {
              "id": 1,
              "vector": [
                1
              ],
              "payload": {
                "color": "red",
                "rank": 3
              }
            },
            {
              "id": 2,
              "vector": [
                1
              ],
              "payload": {
                "color": "red",
                "rank": 1
              }
            },
            {
              "id": 3,
              "vector": [
                1
              ],
              "payload": {
                "color": "blue",
                "rank": 2
              }
            }
          ]
        },
        {
          "op": "facet",
          "args": {
            "key": "color"
          },
          "expect": [
            {
              "value": "red",
              "count": 2
            },
            {
              "value": "blue",
              "count": 1
            }
          ]
        },
        {
          "op": "scroll",
          "args": {
