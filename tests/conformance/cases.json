{
  "_comment": "Shared behaviour spec. Every binding (Rust, Node, Python) runs these cases and must produce identical results. Each case starts with a fresh temporary database and one collection named `c`. Error codes: engine, invalid_argument, not_found, exists, closed.",
  "cases": [
    {
      "name": "nearest neighbours, cosine",
      "config": {
        "vectors": {
          "size": 3,
          "distance": "Cosine"
        }
      },
      "steps": [
        {
          "op": "upsert",
          "args": [
            {
              "id": 1,
              "vector": [
                1,
                0,
                0
              ]
            },
            {
              "id": 2,
              "vector": [
                0.8,
                0.2,
                0
              ]
            },
            {
              "id": 3,
              "vector": [
                0,
                0,
                1
              ]
            }
          ]
        },
        {
          "op": "query",
          "args": {
            "query": [
              1,
              0,
              0
            ],
            "limit": 2
          },
          "expect_ids": [
            1,
            2
          ]
        },
        {
          "op": "query",
          "args": {
            "query": {
              "nearest": [
                0,
                0,
                1
              ]
            },
            "limit": 1
          },
          "expect_ids": [
            3
          ]
        },
        {
          "op": "query",
          "args": {
            "query": [
              1,
              0,
              0
            ],
            "limit": 10,
            "offset": 2
          },
          "expect_ids": [
            3
          ]
        },
        {
          "op": "count",
          "args": {},
          "expect": 3
        }
      ]
    },
    {
      "name": "euclid returns distances, dot returns raw scores",
      "config": {
        "vectors": {
          "l2": {
            "size": 2,
            "distance": "Euclid"
          },
          "ip": {
            "size": 2,
            "distance": "Dot"
          }
        }
      },
      "steps": [
        {
          "op": "upsert",
          "args": [
            {
              "id": 1,
              "vector": {
                "l2": [
                  0,
                  0
                ],
                "ip": [
                  2,
                  3
                ]
              }
            }
          ]
        },
        {
          "op": "query",
          "args": {
            "query": [
              3,
              4
            ],
            "using": "l2"
          },
          "expect_scores": [
            5.0
          ]
        },
        {
          "op": "query",
          "args": {
            "query": [
              1,
              1
            ],
            "using": "ip"
          },
          "expect_scores": [
            5.0
          ]
        }
      ]
    },
    {
      "name": "filters: match, range, any, except, nested, should, must_not, has_id",
      "config": {
        "vectors": {
          "size": 2,
          "distance": "Dot"
        }
      },
      "steps": [
        {
          "op": "upsert",
          "args": [
            {
              "id": 1,
              "vector": [
                1,
                0
              ],
              "payload": {
                "city": "London",
                "price": 10,
                "tags": [
                  "a",
                  "b"
                ],
                "meta": {
                  "stars": 5
                }
              }
            },
            {
              "id": 2,
              "vector": [
                1,
                0
              ],
              "payload": {
                "city": "Paris",
                "price": 20,
                "tags": [
                  "b"
                ],
                "meta": {
                  "stars": 3
                }
              }
            },
            {
              "id": 3,
              "vector": [
                1,
                0
              ],
              "payload": {
                "city": "Berlin",
                "price": 30,
                "tags": [],
                "meta": {
                  "stars": 4
                }
              }
            },
            {
              "id": 4,
              "vector": [
                1,
                0
              ],
              "payload": {
                "city": "London",
                "price": 40
              }
            }
          ]
        },
        {
          "op": "count",
          "args": {
            "filter": {
              "must": [
                {
                  "key": "city",
                  "match": {
                    "value": "London"
                  }
                }
              ]
            }
          },
          "expect": 2
        },
        {
          "op": "count",
          "args": {
            "filter": {
              "must": [
                {
                  "key": "price",
                  "range": {
                    "gt": 10,
                    "lte": 30
                  }
                }
              ]
            }
          },
          "expect": 2
        },
        {
          "op": "count",
          "args": {
            "filter": {
              "must": [
                {
                  "key": "city",
                  "match": {
                    "any": [
                      "Paris",
                      "Berlin"
                    ]
                  }
                }
              ]
            }
          },
          "expect": 2
        },
        {
          "op": "count",
          "args": {
            "filter": {
              "must": [
                {
                  "key": "city",
                  "match": {
                    "except": [
                      "London"
                    ]
                  }
                }
              ]
            }
          },
          "expect": 2
        },
        {
          "op": "count",
          "args": {
            "filter": {
              "must": [
                {
                  "key": "tags",
                  "match": {
                    "value": "b"
                  }
                }
              ]
            }
          },
          "expect": 2
        },
        {
          "op": "count",
          "args": {
            "filter": {
              "must": [
                {
                  "key": "meta.stars",
                  "range": {
                    "gte": 4
                  }
                }
              ]
            }
          },
          "expect": 2
        },
        {
          "op": "count",
          "args": {
            "filter": {
              "should": [
                {
                  "key": "city",
                  "match": {
                    "value": "Paris"
                  }
                },
                {
                  "has_id": [
                    3
                  ]
                }
              ]
            }
          },
          "expect": 2
        },
        {
          "op": "count",
          "args": {
            "filter": {
              "must_not": [
                {
                  "key": "city",
                  "match": {
                    "value": "London"
                  }
                }
              ]
            }
          },
          "expect": 2
        },
        {
          "op": "count",
          "args": {
            "filter": {
              "must": [
                {
                  "is_empty": {
                    "key": "tags"
                  }
                }
              ]
            }
          },
          "expect": 2
        },
        {
          "op": "scroll",
          "args": {
            "filter": {
              "must": [
                {
                  "has_id": [
                    4,
                    2
                  ]
                }
              ]
            }
          },
          "expect_ids": [
            2,
            4
          ]
        }
      ]
    },
    {
