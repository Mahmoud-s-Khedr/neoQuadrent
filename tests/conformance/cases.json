    {
      "name": "hybrid dense + sparse with rrf",
      "config": {
        "vectors": {
          "dense": {
            "size": 2,
            "distance": "Cosine"
          }
        },
        "sparse_vectors": {
          "text": {}
        }
      },
      "steps": [
        {
          "op": "upsert",
          "args": [
            {
              "id": 1,
              "vector": {
                "dense": [
                  1,
                  0
                ],
                "text": {
                  "indices": [
                    5
                  ],
                  "values": [
                    1.0
                  ]
                }
              }
            },
            {
              "id": 2,
              "vector": {
                "dense": [
                  0,
                  1
                ],
                "text": {
                  "indices": [
                    5
                  ],
                  "values": [
                    3.0
                  ]
                }
              }
            },
            {
              "id": 3,
              "vector": {
                "dense": [
                  0.9,
                  0.1
                ],
                "text": {
                  "indices": [
                    9
                  ],
                  "values": [
                    1.0
                  ]
                }
              }
            }
          ]
        },
        {
          "op": "query",
          "args": {
            "query": {
              "indices": [
                5
              ],
              "values": [
                1.0
              ]
            },
            "using": "text"
          },
          "expect_ids": [
            2,
            1
          ]
        },
        {
          "op": "query",
          "args": {
            "prefetch": [
              {
                "query": [
                  1,
