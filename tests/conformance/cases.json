    {
      "name": "payload operations",
      "config": {
        "vectors": {
          "size": 2,
          "distance": "Dot"
        }
      },
      "steps": [
        {
          "op": "upsert",
          "args": [
            {
              "id": 1,
              "vector": [
                1,
                0
              ],
              "payload": {
                "a": 1,
                "b": 2
              }
            },
            {
              "id": 2,
              "vector": [
                0,
                1
              ],
              "payload": {
                "a": 1
              }
            }
          ]
        },
        {
          "op": "set_payload",
          "args": {
            "payload": {
              "c": 3
            },
            "points": [
              1
            ]
          }
        },
        {
          "op": "retrieve",
          "args": {
            "ids": [
              1
            ]
          },
          "expect_payloads": [
            {
              "a": 1,
              "b": 2,
              "c": 3
            }
          ]
        },
        {
          "op": "delete_payload",
          "args": {
            "keys": [
              "a"
            ],
            "filter": {
              "must": [
                {
                  "key": "a",
                  "match": {
                    "value": 1
                  }
                }
              ]
            }
          }
        },
        {
          "op": "retrieve",
          "args": {
            "ids": [
              1,
              2
            ]
          },
          "expect_payloads": [
            {
              "b": 2,
              "c": 3
            },
            {}
          ]
        },
        {
          "op": "overwrite_payload",
          "args": {
            "payload": {
              "z": true
            },
            "points": [
              1
            ]
          }
        },
        {
          "op": "retrieve",
          "args": {
            "ids": [
              1
            ]
          },
          "expect_payloads": [
            {
              "z": true
            }
          ]
        },
        {
          "op": "clear_payload",
          "args": {
            "points": [
              1
            ]
          }
        },
        {
          "op": "retrieve",
          "args": {
            "ids": [
              1
            ]
          },
          "expect_payloads": [
            {}
          ]
        }
      ]
    },
    {
      "name": "string (uuid) and integer ids, scroll pagination",
      "config": {
        "vectors": {
          "size": 1,
          "distance": "Dot"
        }
      },
      "steps": [
        {
          "op": "upsert",
          "args": [
            {
              "id": 3,
              "vector": [
                1
              ]
            },
            {
              "id": 1,
              "vector": [
                1
              ]
            },
            {
              "id": 2,
              "vector": [
                1
              ]
            },
            {
              "id": "00000000-0000-0000-0000-000000000001",
              "vector": [
                1
              ]
            }
          ]
        },
        {
          "op": "scroll",
          "args": {
            "limit": 2
          },
          "expect_ids": [
            1,
            2
          ],
          "expect_next": 3
        },
        {
          "op": "scroll",
          "args": {
            "limit": 10,
            "offset": 3
          },
          "expect_ids": [
            3,
            "00000000-0000-0000-0000-000000000001"
          ],
          "expect_next": null
        }
      ]
    },
    {
      "name": "payload index, facet, order_by",
      "config": {
