            "limit": 1
          },
          "expect_ids": [
            2
          ]
        },
        {
          "op": "retrieve",
          "args": {
            "ids": [
              3
            ]
          },
          "expect_payloads": [
            {
              "n": 3
            }
          ]
        }
      ]
    },
