                "always_ram": true
              }
            }
          }
        },
        "on_disk_payload": true,
        "optimizers_config": {
          "indexing_threshold": 0
        }
      },
      "steps": [
        {
          "op": "upsert",
          "args": [
            {
              "id": 1,
              "vector": {
                "colbert": [
                  [
                    1,
                    0
                  ],
                  [
                    0.9,
                    0.1
                  ]
                ],
                "q": [
                  1,
                  0,
                  0,
                  0
                ]
              },
              "payload": {
                "n": 1
              }
            },
            {
              "id": 2,
              "vector": {
                "colbert": [
                  [
                    0,
                    1
                  ],
                  [
                    0.1,
                    0.9
                  ]
                ],
                "q": [
                  0,
                  1,
                  0,
                  0
                ]
              },
              "payload": {
                "n": 2
              }
            },
            {
              "id": 3,
              "vector": {
                "colbert": [
                  [
                    0.7,
                    0.7
                  ]
                ],
                "q": [
                  0.5,
                  0.5,
                  0,
                  0
                ]
              },
              "payload": {
                "n": 3
              }
            }
          ]
        },
        {
          "op": "query",
          "args": {
            "query": [
              [
                1,
                0
              ]
            ],
            "using": "colbert",
            "limit": 3
          },
          "expect_ids": [
            1,
            3,
            2
          ]
        },
        {
          "op": "optimize"
        },
        {
          "op": "query",
          "args": {
            "query": [
              1,
              0.1,
              0,
              0
            ],
            "using": "q",
            "limit": 2,
            "params": {
