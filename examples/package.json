{
  "name": "neoquadrant-examples",
  "private": true,
  "type": "module",
  "description": "Five retrieval projects that exercise neoquadrant end to end",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --ignoreConfig --noEmit --strict --types node ../bindings/node/index.d.ts",
    "spike": "tsx shared/spike.ts",
    "p1": "tsx 01-notes-search/experiment.ts",
    "p1:search": "tsx 01-notes-search/search.ts",
    "p3": "tsx 03-duplicate-questions/experiment.ts",
    "p5": "tsx 05-hybrid-docs/experiment.ts",
    "p5:prepare": "tsx 05-hybrid-docs/prepare.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "hyparquet": "^1.31.4",
    "neoquadrant": "file:../bindings/node",
    "sharp": "^0.35.5",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
